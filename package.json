{
  "name": "hono-boilerplate",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply boilerplate-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply boilerplate-db --remote",
    "db:seed": "pnpm tsx src/server/db/seed.ts",
    "cf-typegen": "wrangler types",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "typecheck:client": "tsc --build tsconfig.app.json",
    "typecheck:server": "tsc --build tsconfig.server.json",
    "test:unit:server": "vitest run --coverage",
    "test:unit:client": "vitest --config vitest.config.frontend.ts run --coverage",
    "test:unit:merge": "mkdir -p .nyc_output && cp coverage/.unit-server/coverage-final.json .nyc_output/server.json && cp coverage/.unit-client/coverage-final.json .nyc_output/client.json && nyc report --reporter=html --reporter=text --reporter=lcov --report-dir=coverage/unit && rm -rf .nyc_output coverage/.unit-server coverage/.unit-client",
    "test:unit": "rm -rf coverage/.unit-server coverage/.unit-client coverage/unit && pnpm test:unit:server || true && pnpm test:unit:client || true && pnpm test:unit:merge",
    "test:unit:watch": "vitest --coverage",
    "test:integration": "vitest run --config src/server/__integration__/vitest.config.ts --coverage",
    "test:integration:watch": "vitest --config src/server/__integration__/vitest.config.ts --coverage",
    "test:e2e": "rm -rf .nyc_output coverage/e2e; E2E_COVERAGE=true pnpm playwright test; pnpm nyc report",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "E2E_COVERAGE=true playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.3",
    "@hono/zod-openapi": "^1.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-router": "^1.144.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.69.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "uuidv7": "^1.1.0",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.17.1",
    "@cloudflare/workers-types": "^4.20260101.0",
    "@eslint-react/eslint-plugin": "^2.5.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@tanstack/eslint-plugin-router": "^1.141.0",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tanstack/react-router-devtools": "^1.144.0",
    "@tanstack/router-plugin": "^1.145.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser": "^4.0.16",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-istanbul": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "better-sqlite3": "^12.5.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-plugin-boundaries": "^5.3.1",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.8.3",
    "eslint-plugin-unicorn": "^62.0.0",
    "jsdom": "^27.4.0",
    "nyc": "^17.1.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "uuid": "^13.0.0",
    "vite": "^7.3.0",
    "vite-plugin-istanbul": "^7.2.1",
    "vitest": "^4.0.16",
    "wrangler": "^4.54.0"
  }
}
