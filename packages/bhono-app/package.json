{
  "name": "@etus/bhono",
  "version": "0.2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/etusdigital/bhono"
  },
  "files": [
    "dist",
    "templates"
  ],
  "bin": {
    "bhono-app": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "sync": "cd ../.. && ./scripts/sync-template.sh",
    "prepublishOnly": "npm run sync && npm run build",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.0",
    "@octokit/rest": "^22.0.1",
    "commander": "^12.0.0",
    "fs-extra": "^11.3.5",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.7"
  }
}
