  "commandTests": {
    "description": "Tests for skill activation based on command names. Note: Commands trigger skills via their name keywords, not their expanded content.",
    "commands": {
      "/ship": {
        "expectedSkills": ["ship"],
        "reason": "Command name contains 'ship' keyword"
      },
      "/ship --pr pull request": {
        "expectedSkills": ["ship"],
        "reason": "Ship command with PR flag - contains ship and pull request keywords"
      },
      "/linear:implement-issue AA-123": {
        "expectedSkills": ["linear", "superpowers:brainstorming"],
        "reason": "Command contains 'linear', 'issue', and 'implement' keywords"
      },
      "/linear:create-issue": {
        "expectedSkills": ["linear"],
        "reason": "Command contains 'linear', 'create issue' keywords"
      },
      "/linear:process-triage": {
